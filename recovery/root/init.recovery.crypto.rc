# Experimental TB300FU S101116 integration, derived from stock microtrust.rc.
# Deliberately excludes provisioning/keybox, persist and data-directory actions.
# Services start ONLY when the synchronous pre-metadata hook requests them.
on init
    setprop ro.hardware.gatekeeper beanpod

on fs
    chmod 0660 /dev/teei_client
    chown system system /dev/teei_client
    chmod 0660 /dev/teei_config
    chown system system /dev/teei_config
    chmod 0660 /dev/tz_vfs
    chown system system /dev/tz_vfs
    chmod 0660 /dev/teei_fp
    chown system system /dev/teei_fp
    chmod 0660 /dev/ut_keymaster
    chown system drmrpc /dev/ut_keymaster
    chmod 0660 /dev/rpmb0
    chown system system /dev/rpmb0
    chmod 0660 /dev/mmcblk0rpmb
    chown root system /dev/mmcblk0rpmb

service teei_daemon /vendor/bin/teei_daemon -r 020b0000000000000000000000000000 -r 020f0000000000000000000000000000 -r 06090000000000000000000000000000 -r 05120000000000000000000000000000 -r 40188311faf343488db888ad39496f9a -r 07060000000000000000000000007169 -r 4be4f7dc1f2c11e5b5f7727283247c7f -r 9073f03a9618383bb1856eb3f990babd -r 08050000000000000000000000003419 -r 5020170115e016302017012521300000 -r 0f5eed3c3b5a47afacca69a84bf0efad -r 07407000000000000000000000000000 -r 05160000000000000000000000000000 -r 91dba524a6e24909acc48abd7163121a -r 08070000000000000000000000008270 -r 09080000000000000000000000009381 -t 08030000000000000000000000000000 -t 85f630e0f0964c5fa2cc268ce04e3da3 -t 98fb95bcb4bf42d26473eae48690d7ea -t 7b66512021214487ba710a51d7ea78fe -t 09010000000000000000000000000000
    class core
    user system
    group system
    disabled
    oneshot
    setenv LD_LIBRARY_PATH /vendor/lib:/vendor/lib/hw:/system/lib
    seclabel u:r:recovery:s0

service vendor.keymaster-4-0-beanpod /vendor/bin/hw/android.hardware.keymaster@4.0-service.beanpod
    class early_hal
    user system
    group system drmrpc
    disabled
    oneshot
    setenv LD_LIBRARY_PATH /vendor/lib:/vendor/lib/hw:/system/lib
    seclabel u:r:recovery:s0

service vendor.gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    class hal
    user system
    group system
    disabled
    oneshot
    setenv LD_LIBRARY_PATH /vendor/lib:/vendor/lib/hw:/system/lib
    seclabel u:r:recovery:s0
